rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    function isManager() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }

    function isUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["user", "member"];
    }

    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    function isDocumentOwner() {
      return isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidCreateFields() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) && hasValidCreateFields();
      allow update: if isSelf(userId) || isOwner();
      allow delete: if isOwner();
    }

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || (isUser() && request.resource.data.uid == request.auth.uid && hasValidCreateFields());
      allow update: if isOwnerOrManager() || (isUser() && resource.data.uid == request.auth.uid);
      allow delete: if isOwnerOrManager();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /beds/{bedId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /staff/{staffId} {
      allow read: if isOwnerOrManager() || isStaff();
      allow create: if isOwnerOrManager() && hasValidCreateFields();
      allow update: if isOwner() || (isManager() && isDocumentOwner()) || (isStaff() && isDocumentOwner());
      allow delete: if isOwner();
    }

    match /meals/{mealId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /bazar/{bazarId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /utilities/{utilityId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /deposits/{depositId} {
      allow read: if isOwnerOrManager() || isUser();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /credits/{creditId} {
      allow read: if isOwnerOrManager() || isUser();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /rent_ledgers/{ledgerId} {
      allow read: if isOwnerOrManager() || (isUser() && resource.data.uid == request.auth.uid);
      allow create: if isOwnerOrManager() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields() || isUser() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isOwnerOrManager() && isDocumentOwner()) || (isUser() && isDocumentOwner());
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /monthly_closing/{closingId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && hasValidCreateFields();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /activity_logs/{logId} {
      allow read: if isOwnerOrManager();
      allow create: if isSignedIn() && hasValidCreateFields();
      allow update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
