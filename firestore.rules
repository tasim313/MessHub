rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    function isManager() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }

    function isUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["user", "member"];
    }

    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    function isDocumentOwner() {
      return isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidCreateFields() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // Self-signup must supply its own createdBy; an owner creating a user
      // via /admin (adminCreateUser) writes this doc under their own auth
      // session for a different uid, so hasValidCreateFields() doesn't apply.
      allow create: if (isSelf(userId) && hasValidCreateFields()) || isOwner();
      allow update: if isSelf(userId) || isOwner();
      allow delete: if isOwner();
    }

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || (isUser() && request.resource.data.uid == request.auth.uid);
      allow update: if isOwnerOrManager() || (isUser() && resource.data.uid == request.auth.uid);
      allow delete: if isOwnerOrManager();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /beds/{bedId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /staff/{staffId} {
      allow read: if isOwnerOrManager() || isStaff();
      allow create: if isOwnerOrManager();
      allow update: if isOwner() || (isManager() && isDocumentOwner()) || (isStaff() && isDocumentOwner());
      allow delete: if isOwner();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /meals/{mealId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /meal_entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /bazar/{bazarId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /utilities/{utilityId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /utility_allocations/{allocationId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /staff_allocations/{allocationId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /rent_charges/{chargeId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    // Shared expenses (water/electricity/internet/garbage/etc.) and the
    // records createExpenseWithAccounting() derives from them: per-member
    // allocations and any advance created when a payer overpays their share.
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /expense_allocations/{allocationId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /advances/{advanceId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    // Recurring bill templates (water/internet/garbage/etc.) that the
    // auto-generation service turns into real expenses on the 1st of each
    // month — see ensureRecurringExpensesUpToDate in recurring-bill-service.ts.
    match /recurring_bills/{billId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /credits/{creditId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner() || isOwnerOrManager() || isUser();
    }

    match /ledgers/{ledgerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // Payment <-> charge allocation records (who/what settled which charge).
    // Written by the same flows that record payments, so mirrors payments/ledgers access.
    match /charge_allocations/{allocationId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() || isUser();
      allow update, delete: if isOwner();
    }

    // Credit notes and refunds are deliberate financial corrections, not
    // member self-service records — restricted to owner/manager. Never
    // deleted; a correction is "voided" via update (status + voidedBy/
    // voidedReason), preserving the full history of what happened and why.
    match /credit_notes/{creditNoteId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    match /refunds/{refundId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /monthly_closing/{closingId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager();
      allow update, delete: if isOwner() || (isManager() && isDocumentOwner());
    }

    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    match /change_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner() || (isManager() && resource.data.requestedByUid != request.auth.uid);
      allow delete: if isOwner();
    }

    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}